# Discord bot token (required)
# Create a bot at https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# OpenRouter API key (required for insight commands)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here

# Optional: override the default LLM model
# OPENROUTER_MODEL=anthropic/claude-opus-4.6

# Optional: restrict the bot to a single channel by ID
# JOURNAL_CHANNEL_ID=123456789012345678

# Post Fiat testnet — master wallet seed for airdropping to new users (required for /postfiat)
# PFT_MASTER_SEED=sYourMasterSeedHere

# Optional: override the default airdrop amount (default: 50 PFT)
# PFT_AIRDROP_AMOUNT=50
